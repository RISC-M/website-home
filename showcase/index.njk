---
layout: layouts/base.njk
title: Project Showcase
description: Explore what RISC-M members are building, from first prototypes to completed projects.
---
<section class="showcase-hero" aria-labelledby="showcase-title">
  <h1 id="showcase-title">Project<br>Showcase</h1>
  <p class="showcase-intro">Projects from RISC-M members, in progress and completed.</p>
</section>
<section class="showcase-projects" aria-label="Member projects">
  <div class="showcase-controls" hidden>
    <div class="showcase-filters" role="group" aria-label="Filter by project status">
      <button type="button" data-status-filter="all" aria-pressed="true" aria-controls="showcase-grid">All projects</button>
      <button type="button" data-status-filter="in-progress" aria-pressed="false" aria-controls="showcase-grid">In progress</button>
      <button type="button" data-status-filter="completed" aria-pressed="false" aria-controls="showcase-grid">Completed</button>
    </div>
    <div class="showcase-sort">
      <label for="showcase-sort">Sort by</label>
      <select id="showcase-sort"><option value="newest">Newest first</option><option value="oldest">Oldest first</option></select>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </div>
  </div>
  <p id="showcase-count" class="showcase-count" role="status" aria-live="polite" aria-atomic="true">{{ collections.projects | length }} {% if collections.projects | length == 1 %}project{% else %}projects{% endif %}</p>
  <div id="showcase-grid" class="showcase-grid{% if collections.projects | length == 1 %} showcase-grid-single{% endif %}">
    {% for project in collections.projects %}
    <article class="showcase-card" data-project data-status="{{ project.data.status }}" data-published="{{ project.data.published | isoDate }}" data-title="{{ project.data.title | escape }}" aria-labelledby="project-{{ project.data.slug }}">
      <div class="showcase-card-content">
        <span class="project-status status-{{ project.data.status }}"><span aria-hidden="true">{% if project.data.status == 'completed' %}✓{% endif %}</span>{% if project.data.status == 'completed' %}Completed{% else %}In progress{% endif %}</span>
        <h2 id="project-{{ project.data.slug }}"><a class="showcase-card-primary" data-project-link href="{{ project.url }}">{{ project.data.title | escape }}</a></h2>
        <p class="showcase-card-description">{{ project.data.blurb | escape }}</p>
      </div>
      <div class="showcase-card-footer">
        <div class="showcase-contributors">
          <span class="showcase-author-label">By</span>
          <ul class="showcase-author-list" aria-label="Project contributors">
            {% for person in project.data.contributors %}
            <li><a class="showcase-author" href="{{ person.linkedin | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ person.name | escape }} on LinkedIn (opens in a new tab)">{{ person.name | escape }} <span aria-hidden="true">↗</span></a></li>
            {% endfor %}
          </ul>
        </div>
        <p class="showcase-published">Published <time datetime="{{ project.data.published | isoDate }}">{{ project.data.published | displayDate }}</time></p>
        <div class="showcase-card-links">
          <a class="showcase-button showcase-button-primary showcase-read" data-project-link href="{{ project.url }}" aria-label="Read project: {{ project.data.title | escape }}">Read project <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
          <a class="showcase-button showcase-github" href="{{ project.data.github | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ project.data.title | escape }} on GitHub (opens in a new tab)">GitHub <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a>
        </div>
      </div>
    </article>
    {% endfor %}
  </div>
  <div id="showcase-empty" class="showcase-empty" {% if collections.projects | length %}hidden{% endif %}>
    {% if collections.projects | length %}
    <h2>No projects with this status yet.</h2>
    <p>See what our members are working on in the full showcase.</p>
    <button type="button" class="showcase-button" id="showcase-reset">Show all projects <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
    {% else %}
    <h2>No projects published yet.</h2>
    <p>Member projects will appear here. In the meantime, get to know RISC-M.</p>
    <a class="showcase-button" href="/about.html">About the club <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
    {% endif %}
  </div>
  <noscript><p class="showcase-noscript">All published projects are shown newest first. Enable JavaScript to filter and change the sort order.</p></noscript>
</section>
