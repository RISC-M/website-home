<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{{ title | escape }} | RISC-M</title>
  <meta name="description"
    content="{{ description | default(blurb, true) | escape }}" />
  <link rel="canonical" href="https://www.risc-m.com{{ page.url }}" />



  <link rel="icon" href="/logo-white.png" type="image/png" />
  <link rel="apple-touch-icon" href="/logo-white.png" />

  <meta property="og:site_name" content="RISC-M" />
  <meta property="og:title" content="{{ title | escape }} | RISC-M" />
  <meta property="og:description" content="{{ description | default(blurb, true) | escape }}" />
  <meta property="og:type" content="{% if projectPage %}article{% else %}website{% endif %}" />
  <meta property="og:url" content="https://www.risc-m.com{{ page.url }}" />
  <meta property="og:image" content="https://www.risc-m.com/logo-black.png" />
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=swap"
    rel="stylesheet">

  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="/showcase.css" />
</head>
<body class="showcase-site">
  <a class="showcase-skip" href="#main-content">Skip to content</a>
  <header class="showcase-site-header">
    <a href="/" class="showcase-brand"><span aria-hidden="true"></span>RISC-M</a>
    <nav class="showcase-site-nav" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/about.html">About</a>
      <a href="/sponsorship.html">Sponsorship</a>
      <a href="/showcase/" aria-current="{% if projectPage %}location{% else %}page{% endif %}">Showcase</a>
    </nav>
  </header>
  <main id="main-content" class="showcase-main" tabindex="-1">
    {{ content | safe }}
  </main>
  <footer class="showcase-site-footer">
    <p>&copy; 2026 <span class="font-outfit">RISC-M</span></p>
    <nav aria-label="Contact RISC-M">
      <a href="mailto:riscm-exec@umich.edu">Email</a>
      <a href="https://www.linkedin.com/company/risc-m/" target="_blank" rel="noopener noreferrer" aria-label="RISC-M on LinkedIn (opens in a new tab)">LinkedIn <span aria-hidden="true">↗</span></a>
    </nav>
  </footer>
  <script src="/showcase.js" defer></script>
</body>
</html>
